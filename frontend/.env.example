# ==========================================
# 관제 센터 웹 대시보드 (Frontend) 환경 변수 설정
# ==========================================

# 1. 카카오 맵 API (Kakao Maps API)
# 발급 위치: https://developers.kakao.com/ -> 내 애플리케이션 -> 앱 키 -> JavaScript 키
VITE_KAKAO_MAP_API_KEY=your_kakao_javascript_app_key_here

# 2. 네이버 지도 API (Naver Maps API)
# 발급 위치: https://console.ncloud.com/ -> Application Services -> Maps -> Client ID
VITE_NAVER_MAP_CLIENT_ID=your_naver_maps_client_id_here

# 3. Google Maps API / MapTiler API
# 발급 위치: https://console.cloud.google.com/ or https://cloud.maptiler.com/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# 4. 백엔드 API 연결 서버 URL
VITE_BACKEND_URL=http://localhost:3000
